# Frontend build-time setting. Use wss:// in production.
VITE_WORLD_SERVER_URL=ws://127.0.0.1:8787/socket

# Backend runtime settings.
PORT=8787
DATABASE_URL=
DATABASE_SSL=require
DATABASE_POOL_SIZE=5
SESSION_SECRET=replace-with-a-long-random-value
SESSION_TTL_MS=2592000000
ALLOWED_ORIGINS=http://127.0.0.1:4173

# Development-only fallback when DATABASE_URL is empty.
GENERATION_LEAGUE_DATA=./server/.world-state.json
